[Unit]
Description=Craftpick Filter - anti-DDoS maison
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/lib/craftpick-filter/apply-rules.sh
ExecStart=/usr/local/bin/craftpick-filterd
Restart=always
RestartSec=3
Nice=-5

[Install]
WantedBy=multi-user.target
