# ================= Craftpick Filter — configuration =================
# Copie ce fichier vers /etc/craftpick-filter/config.conf (install.sh le fait
# automatiquement s'il n'existe pas encore) puis adapte les valeurs ci-dessous.
# Après toute modification : craftpick-filter reload

SERVER_NAME="mon-vps"          # identifiant envoyé à l'API (ex: hostname -s)
INTERFACE="eth0"               # interface réseau à surveiller (ip route show default)
PORTS="all"                    # ports TCP protégés, séparés par des virgules, ou "all" pour toute la machine
INTERVAL=2                     # secondes entre deux analyses

# --- Export API (POST JSON, header Authorization: Bearer) ---
API_URL=""                     # ex: http://127.0.0.1:8688/events (Craftpick API en local ou distante)
API_KEY=""                     # récupérable avec `craftpick-api key` sur la machine qui héberge l'API
EXPORT_BANS=1                  # exporter aussi les bans hors attaque

# --- Contrôle distant : l'API peut ban/unban/whitelist/lockdown à distance ---
REMOTE_CONTROL=1               # 0 pour désactiver le polling de commandes
API_CMD_URL=""                 # vide = "${API_URL}/commands"
CMD_POLL_EVERY=5               # interroger l'API toutes les N boucles (N x INTERVAL secondes)

# --- Couche kernel (nftables) ---
NFT_NEWCONN_RATE=5             # nouvelles connexions / seconde / IP
NFT_NEWCONN_BURST=10
NFT_MAX_CONN_PER_IP=10         # connexions simultanées max / IP

# --- Détection des pics (baseline apprise automatiquement) ---
SPIKE_FACTOR=4                 # pic = valeur > baseline x SPIKE_FACTOR
MIN_CPS=25                     # plancher : nouvelles connexions / s
MIN_CONNS=100                  # plancher : connexions établies
MIN_PPS=30000                  # plancher : paquets / s entrants
SYN_RECV_MAX=256               # SYN à moitié ouverts => SYN flood
DROP_ALERT_PPS=5000            # paquets filtrés / s => attaque en cours
WARMUP_CYCLES=60               # cycles d'apprentissage avant détection des pics
END_CALM_CYCLES=30             # cycles calmes avant de déclarer la fin d'une attaque

# --- Protection HTTP (couche 7) — détecte les floods de requêtes via keep-alive ---
# Les connexions HTTP persistantes échappent au comptage "nouvelle connexion" ci-dessus :
# un flood peut arriver via peu de connexions qui envoient beaucoup de requêtes.
HTTP_ENABLE=1                   # 0 pour désactiver (aucun log web trouvé, ou géré ailleurs)
HTTP_LOG_PATHS="/var/log/nginx/access.log /var/log/nginx/*access*.log /var/www/*/logs/access.log /var/www/*/access.log /var/log/apache2/access.log /var/log/apache2/*access*.log /var/log/httpd/access_log"
HTTP_PER_IP_RPS_MAX=15          # requêtes/s par IP tolérées hors attaque
HTTP_PER_IP_RPS_MAX_ATTACK=6    # seuil abaissé une fois une attaque déjà détectée
HTTP_SPIKE_FACTOR=4             # pic global = requêtes/s > baseline x ce facteur
HTTP_MIN_RPS=50                 # plancher avant qu'un pic global ne compte comme attaque
HTTP_BAN_DURATION="2h"
HTTP_RESCAN_EVERY=150           # cycles entre deux redécouvertes de nouveaux logs (vhosts ajoutés)

# --- Mitigation automatique ---
AUTO_BAN=1
PER_IP_MAX_CONN=5              # ban si une IP dépasse ça (temps normal)
PER_IP_MAX_CONN_ATTACK=3       # ban si une IP dépasse ça (pendant une attaque)
SYN_PER_IP_MAX=20
BAN_DURATION="1h"
LOCKDOWN=1                     # pendant une attaque : IP jamais vues limitées globalement
LOCKDOWN_CPS=5                 # nouvelles co / s autorisées pour les IP inconnues
