#!/usr/bin/env bash
T=craftpick_filter; ETC=/etc/craftpick-filter
[[ $EUID -eq 0 ]] || { echo "Root requis (sudo)."; exit 1; }
source $ETC/config.conf
fam() { [[ $1 == *:* ]] && echo 6 || echo 4; }
count() { nft -j list set inet $T "$1" 2>/dev/null | jq '[.nftables[]|select(.set)|(.set.elem // [])|length]|add // 0'; }

case "${1:-}" in
  status)
    systemctl is-active --quiet craftpick-filter && echo "Service     : ✅ actif" || echo "Service     : ❌ inactif"
    echo "IP bannies  : $(( $(count blacklist4) + $(count blacklist6) ))"
    echo "IP connues  : $(( $(count known4) + $(count known6) ))"
    [[ -f /run/craftpick-filter/metrics.json ]] && jq . /run/craftpick-filter/metrics.json ;;
  bans)      nft list set inet $T blacklist4; nft list set inet $T blacklist6 ;;
  ban)       [[ -n ${2:-} ]] || { echo "Usage: $0 ban <ip> [durée ex: 2h]"; exit 1; }
             nft add element inet $T "blacklist$(fam "$2")" "{ $2 timeout ${3:-$BAN_DURATION} }" && ss -K dst "$2" &>/dev/null
             echo "$2 banni" ;;
  unban)     [[ -n ${2:-} ]] || { echo "Usage: $0 unban <ip>"; exit 1; }
             nft delete element inet $T "blacklist$(fam "$2")" "{ $2 }" && echo "$2 débanni" ;;
  whitelist) [[ -n ${2:-} ]] || { echo "Usage: $0 whitelist <ip|cidr>"; exit 1; }
             echo "$2" >> $ETC/whitelist.txt
             nft delete element inet $T "blacklist$(fam "$2")" "{ $2 }" &>/dev/null
             nft add element inet $T "whitelist$(fam "$2")" "{ $2 }" && echo "$2 ajouté à la whitelist" ;;
  lockdown)  case "${2:-}" in
               on)  nft add rule inet $T lockdown ip saddr != @known4 limit rate over ${LOCKDOWN_CPS}/second drop
                    nft add rule inet $T lockdown ip6 saddr != @known6 limit rate over ${LOCKDOWN_CPS}/second drop
                    echo "Lockdown manuel activé" ;;
               off) nft flush chain inet $T lockdown; echo "Lockdown désactivé" ;;
               *)   echo "Usage: $0 lockdown on|off" ;;
             esac ;;
  reload)    /usr/local/lib/craftpick-filter/apply-rules.sh --force && systemctl restart craftpick-filter
             echo "Règles rechargées (les bans en cours sont réinitialisés)" ;;
  test-api)  [[ -n $API_URL ]] || { echo "API_URL vide dans $ETC/config.conf"; exit 1; }
             code=$(curl -s -o /dev/null -w '%{http_code}' -m 5 -X POST -H "Content-Type: application/json" \
               -H "Authorization: Bearer $API_KEY" \
               -d "$(jq -nc --arg s "$SERVER_NAME" '{event:"test", server:$s, ts:(now|todate)}')" "$API_URL")
             echo "Réponse de l'API : HTTP $code" ;;
  reset-baseline) rm -f /var/lib/craftpick-filter/baseline && systemctl restart craftpick-filter
             echo "Baseline effacée, réapprentissage en cours" ;;
  logs)      tail -n 50 -f /var/log/craftpick-filter.log ;;
  *)
    cat <<USAGE
Craftpick Filter — commandes :
  status               état du service + métriques temps réel
  bans                 liste des IP bannies
  ban <ip> [durée]     bannir une IP
  unban <ip>           débannir une IP
  whitelist <ip|cidr>  ne jamais filtrer cette IP
  lockdown on|off      forcer / couper le mode lockdown
  reload               recharger la config et les règles
  test-api             envoyer un événement de test à l'API
  reset-baseline       réapprendre le trafic normal
  logs                 suivre les logs
USAGE
    ;;
esac
